  completionMessage: "\uCCAB \uC81C\uC791\uC744 \uC131\uACF5\uD558\uC2E0 \uAC83\uC744
    \uCD95\uD558\uB4DC\uB9AC\uBA70 \uB300\uC7A5\uC7A5\uC774\uB2D8\uAED8 \uC18C\uC815\uC758
    \uC9C0\uC6D0\uAE08\uC744 \uB4DC\uB9AC\uB3C4\uB85D \uD558\uACA0\uC2B5\uB2C8\uB2E4!"
  heatGuide: "\uAC00\uC5F4 \uB2E8\uACC4 : \uB9C8\uC6B0\uC2A4\uB97C \uB204\uB974\uACE0
    \uC788\uC73C\uBA74 \uB9C9\uB300\uAC00 \uC62C\uB77C\uAC11\uB2C8\uB2E4. \uBAA9\uD45C
    \uC704\uCE58\uC5D0 \uB9DE\uCDB0 \uC720\uC9C0\uD558\uC138\uC694."
  forgeGuide: "\uB2E8\uC870 \uB2E8\uACC4 : \uC904\uC5B4\uB4DC\uB294 \uC6D0\uC774
    \uC548\uCABD \uC6D0\uC5D0 \uACB9\uCE60 \uB54C \uD074\uB9AD\uD558\uC138\uC694."
  heatTreatGuide: "\uC5F4\uCC98\uB9AC \uB2E8\uACC4 : \uC6C0\uC9C1\uC774\uB294 \uD45C\uC2DC\uAC00
    \uBAA9\uD45C \uAD6C\uAC04\uC5D0 \uB4E4\uC5B4\uAC00\uBA74 \uD074\uB9AD\uD558\uC138\uC694."
  polishGuide: "\uC5F0\uB9C8 \uB2E8\uACC4 : \uD760\uC9D1\uC744 \uB204\uB978 \uCC44
